# ============================================
# Audiq — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ── DATABASE (Neon PostgreSQL) ─────────────
# Get this from: https://console.neon.tech → Your Project → Connection String
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/audiq?sslmode=require"

# ── WORKER (Zeabur) ────────────────────────
# URL of your deployed worker on Zeabur
# Get this from: Zeabur Dashboard → Your Service → Networking → Public URL
WORKER_URL="https://your-worker.zeabur.app"

# Secret key for authenticating requests between Vercel and Zeabur
# Set this to the same value in both Vercel and Zeabur env vars
WORKER_SECRET="your-random-secret-here"

# ── OPTIONAL ─────────────────────────────
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="your-nextauth-secret"
