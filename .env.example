# ============================================
# Audiq — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ── DATABASE (Neon PostgreSQL) ─────────────
# Get this from: https://console.neon.tech → Your Project → Connection String
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/audiq?sslmode=require"

# ── WORKER (SnapDeploy) ─────────────────────
# URL of your deployed worker on SnapDeploy
# Get this from: SnapDeploy Dashboard → Your Container → Overview
WORKER_URL="https://audiq-worker.snapdeploy.app"

# Secret key for authenticating requests between Vercel and SnapDeploy
# Set this to the same value in both Vercel and SnapDeploy env vars
WORKER_SECRET="your-random-secret-here"

# ── OPTIONAL ─────────────────────────────
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="your-nextauth-secret"
