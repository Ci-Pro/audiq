# ============================================
# VortexTube — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ── DATABASE (Neon PostgreSQL) ─────────────
# Get this from: https://console.neon.tech → Your Project → Connection String
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/vortextube?sslmode=require"

# ── WORKER (Render) ───────────────────────
# URL of your deployed worker on Render
# Get this from: Render Dashboard → Your Service → Settings → Web Service
WORKER_URL="https://vortextube-worker.onrender.com"

# Secret key for authenticating requests between Vercel and Render
# Set this to the same value in both Vercel and Render env vars
WORKER_SECRET="your-random-secret-here"

# ── OPTIONAL ─────────────────────────────
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="your-nextauth-secret"
