generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DownloadTask {
  id          String   @id @default(cuid())
  url         String
  videoId     String
  title       String
  thumbnail   String?
  duration    Int?
  channel     String?
  format      String   // "mp3" or "mp4"
  quality     String   // "360p", "480p", "720p", "1080p", "128kbps", "192kbps", "320kbps"
  status      String   @default("pending") // "pending", "processing", "completed", "failed"
  progress    Float    @default(0)
  fileSize    Int?     // bytes
  filePath    String?
  error       String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
}
